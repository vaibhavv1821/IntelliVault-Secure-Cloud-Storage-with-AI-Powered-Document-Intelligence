# ==============================================================================
# IntelliVault ~ Environment Configuration Template
# Duplicate this file to '.env' and populate with your environment credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=backend/run.py
FLASK_ENV=development
FLASK_DEBUG=True
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# MongoDB Database Configuration
# Local URI: mongodb://127.0.0.1:27017/intellivault
# Atlas URI: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/intellivault?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/intellivault
MONGODB_DB_NAME=intellivault

# MinIO / S3 Object Storage Configuration
# Local MinIO default endpoint: 127.0.0.1:9000
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=intellivault-files
MINIO_SECURE=False

# JWT Authentication & Authorization
JWT_SECRET_KEY=change-this-to-a-secure-jwt-signing-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# File Encryption (AES-256 GCM)
# 32-byte url-safe base64-encoded key: generated via python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=dGhpc2lzYTMyeWJ5dGVzZWNyZXRrZXlmb3JkZXZlbG9wbWVudCE=

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:5000/api
