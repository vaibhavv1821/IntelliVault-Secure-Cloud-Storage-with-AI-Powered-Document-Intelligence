# ==============================================================================
# IntelliVault Frontend ~ Environment Configuration Template
# ==============================================================================
# In production (e.g. Vercel):
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables:
# VITE_API_BASE_URL=https://intellivault-backend.onrender.com/api
#
# In local development:
# - Leave blank to use Vite dev proxy to http://127.0.0.1:5000/api
# - Or specify the direct backend API URL:
# VITE_API_BASE_URL=http://127.0.0.1:5000/api

VITE_API_BASE_URL=
